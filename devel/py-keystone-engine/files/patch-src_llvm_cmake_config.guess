--- src/llvm/cmake/config.guess.orig
+++ src/llvm/cmake/config.guess
@@ -795,6 +795,13 @@
     *:BSD/OS:*:*)
 	echo ${UNAME_MACHINE}-unknown-bsdi${UNAME_RELEASE}
 	exit ;;
+    *:MidnightBSD:*:*)
+	UNAME_PROCESSOR=`/usr/bin/uname -p`
+	case ${UNAME_PROCESSOR} in
+	    amd64) echo x86_64-unknown-freebsd13.4 ;;
+	    *) echo ${UNAME_PROCESSOR}-unknown-freebsd13.4 ;;
+	esac
+	exit ;;
     *:FreeBSD:*:*)
 	UNAME_PROCESSOR=`/usr/bin/uname -p`
 	case ${UNAME_PROCESSOR} in
