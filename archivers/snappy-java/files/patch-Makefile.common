+FreeBSD-x86_CXXFLAGS     := -I$(JAVA_HOME)/include -Ilib/inc_mac -O2 -fPIC -fvisibility=hidden
+FreeBSD-x86_LINKFLAGS    := -shared -static-libgcc
+FreeBSD-x86_LIBNAME      := libsnappyjava.so
+FreeBSD-x86_SNAPPY_FLAGS :=
+
