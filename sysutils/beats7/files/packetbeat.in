#!/bin/sh

# PROVIDE: packetbeat
# REQUIRE: DAEMON
# BEFORE: LOGIN
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable packetbeat
#
# packetbeat_enable (bool):	Set to YES to enable packetbeat
# 				Default: NO
# packetbeat_flags (str):	Extra flags passed to packetbeat
# packetbeat_config (str):	packetbeat configuration directory
#				Default: ${PREFIX}/etc/beats
# packetbeat_conffile (str):	packetbeat configuration file
#				relative to ${packetbeat_conf}
#				Default: packetbeat.yml
# packetbeat_stop_timeout (int):	Seconds to wait after SIGTERM
#				before sending SIGKILL
#				Default: 15

. /etc/rc.subr

name="packetbeat"
rcvar=${name}_enable
load_rc_config $name

: ${packetbeat_enable:="NO"}
: ${packetbeat_config:="%%ETCDIR%%"}
: ${packetbeat_conffile:="packetbeat.yml"}
: ${packetbeat_home:="%%DATADIR%%/packetbeat"}
: ${packetbeat_logs:="/var/log/beats"}
: ${packetbeat_data:="/var/db/beats/packetbeat"}
: ${packetbeat_stop_timeout:="15"}

# daemon
start_precmd=packetbeat_prestart
stop_cmd=packetbeat_stop
command=/usr/sbin/daemon
pidfile="/var/run/${name}"
child_pidfile="${pidfile}.child"
command_args="-fr -P ${pidfile} -p ${child_pidfile} %%PREFIX%%/sbin/${name} ${packetbeat_flags} --path.config ${packetbeat_config} --path.home ${packetbeat_home} --path.data ${packetbeat_data} --path.logs ${packetbeat_logs} -c ${packetbeat_conffile}"

packetbeat_prestart() {
# Have to empty rc_flags so they don't get passed to daemon(8)
	rc_flags=""
}

# daemon(8) forwards SIGTERM to the beat and stops restarting it.  A beat
# still running after packetbeat_stop_timeout seconds (seen with linprocfs
# mounted) is killed along with daemon(8), so that no orphaned beat keeps
# the data path locked.
packetbeat_stop() {
	local _cpid _pids

	_cpid=$(check_pidfile ${child_pidfile} %%PREFIX%%/sbin/${name})
	# instances started without -p have no child pidfile
	if [ -z "${_cpid}" -a -n "${rc_pid}" ]; then
		_cpid=$(pgrep -P ${rc_pid})
	fi
	_pids=$(echo ${rc_pid} ${_cpid})
	if [ -z "${_pids}" ]; then
		_run_rc_notrunning
		return 1
	fi

	echo "Stopping ${name}."
	kill -TERM ${rc_pid:-${_cpid}}
	if ! pwait -t ${packetbeat_stop_timeout} ${_pids} 2>/dev/null; then
		echo "${name} did not exit after ${packetbeat_stop_timeout}s, sending SIGKILL."
		kill -KILL ${_pids} 2>/dev/null
		wait_for_pids ${_pids}
	fi
	rm -f ${pidfile} ${child_pidfile}
}

run_rc_command "$1"
