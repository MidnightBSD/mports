#!/bin/sh

# PROVIDE: filebeat
# REQUIRE: DAEMON
# BEFORE: LOGIN
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable filebeat:
#
# filebeat_enable (bool):	Set to YES to enable filebeat
# 				Default: NO
# filebeat_flags (str):		Extra flags passed to filebeat
# filebeat_config (str):	filebeat configuration directory
#				Default: ${PREFIX}/etc/beats
# filebeat_conffile (str):	filebeat configuration file
#				relative to ${filebeat_conf}
#				Default: filebeat.yml
# filebeat_stop_timeout (int):	Seconds to wait after SIGTERM
#				before sending SIGKILL
#				Default: 15

. /etc/rc.subr

name="filebeat"
rcvar=${name}_enable
load_rc_config $name

: ${filebeat_enable:="NO"}
: ${filebeat_config:="%%ETCDIR%%"}
: ${filebeat_conffile:="filebeat.yml"}
: ${filebeat_home:="%%DATADIR%%/filebeat"}
: ${filebeat_logs:="/var/log/beats"}
: ${filebeat_data:="/var/db/beats/filebeat"}
: ${filebeat_stop_timeout:="15"}

# daemon
start_precmd=filebeat_prestart
stop_cmd=filebeat_stop
command=/usr/sbin/daemon
pidfile="/var/run/${name}"
child_pidfile="${pidfile}.child"
command_args="-fr -P ${pidfile} -p ${child_pidfile} %%PREFIX%%/sbin/${name} ${filebeat_flags} --path.config ${filebeat_config} --path.home ${filebeat_home} --path.data ${filebeat_data} --path.logs ${filebeat_logs} -c ${filebeat_conffile}"

filebeat_prestart() {
# Have to empty rc_flags so they don't get passed to daemon(8)
	rc_flags=""
}

# daemon(8) forwards SIGTERM to the beat and stops restarting it.  A beat
# still running after filebeat_stop_timeout seconds (seen with linprocfs
# mounted) is killed along with daemon(8), so that no orphaned beat keeps
# the data path locked.
filebeat_stop() {
	local _cpid _pids

	_cpid=$(check_pidfile ${child_pidfile} %%PREFIX%%/sbin/${name})
	# instances started without -p have no child pidfile
	if [ -z "${_cpid}" -a -n "${rc_pid}" ]; then
		_cpid=$(pgrep -P ${rc_pid})
	fi
	_pids=$(echo ${rc_pid} ${_cpid})
	if [ -z "${_pids}" ]; then
		_run_rc_notrunning
		return 1
	fi

	echo "Stopping ${name}."
	kill -TERM ${rc_pid:-${_cpid}}
	if ! pwait -t ${filebeat_stop_timeout} ${_pids} 2>/dev/null; then
		echo "${name} did not exit after ${filebeat_stop_timeout}s, sending SIGKILL."
		kill -KILL ${_pids} 2>/dev/null
		wait_for_pids ${_pids}
	fi
	rm -f ${pidfile} ${child_pidfile}
}

run_rc_command "$1"
