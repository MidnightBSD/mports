#!/bin/sh

# PROVIDE: auditbeat
# REQUIRE: DAEMON
# BEFORE: LOGIN
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable auditbeat:
#
# auditbeat_enable (bool):	Set to YES to enable auditbeat
# 				Default: NO
# auditbeat_flags (str):	Extra flags passed to auditbeat
# auditbeat_config (str):	auditbeat configuration directory
#				Default: ${PREFIX}/etc/beats
# auditbeat_conffile (str):	auditbeat configuration file
#				relative to ${auditbeat_conf}
#				Default: auditbeat.yml
# auditbeat_stop_timeout (int):	Seconds to wait after SIGTERM
#				before sending SIGKILL
#				Default: 15

. /etc/rc.subr

name="auditbeat"
rcvar=${name}_enable
load_rc_config $name

: ${auditbeat_enable:="NO"}
: ${auditbeat_config:="%%ETCDIR%%"}
: ${auditbeat_conffile:="auditbeat.yml"}
: ${auditbeat_home:="%%DATADIR%%/auditbeat"}
: ${auditbeat_logs:="/var/log/beats"}
: ${auditbeat_data:="/var/db/beats/auditbeat"}
: ${auditbeat_stop_timeout:="15"}

# daemon
start_precmd=auditbeat_prestart
stop_cmd=auditbeat_stop
command=/usr/sbin/daemon
pidfile="/var/run/${name}"
child_pidfile="${pidfile}.child"
command_args="-fr -P ${pidfile} -p ${child_pidfile} %%PREFIX%%/sbin/${name} ${auditbeat_flags} --path.config ${auditbeat_config} --path.home ${auditbeat_home} --path.data ${auditbeat_data} --path.logs ${auditbeat_logs} -c ${auditbeat_conffile}"
auditbeat_prestart() {
# Have to empty rc_flags so they don't get passed to daemon(8)
	rc_flags=""
}

# daemon(8) forwards SIGTERM to the beat and stops restarting it.  A beat
# still running after auditbeat_stop_timeout seconds (seen with linprocfs
# mounted) is killed along with daemon(8), so that no orphaned beat keeps
# the data path locked.
auditbeat_stop() {
	local _cpid _pids

	_cpid=$(check_pidfile ${child_pidfile} %%PREFIX%%/sbin/${name})
	# instances started without -p have no child pidfile
	if [ -z "${_cpid}" -a -n "${rc_pid}" ]; then
		_cpid=$(pgrep -P ${rc_pid})
	fi
	_pids=$(echo ${rc_pid} ${_cpid})
	if [ -z "${_pids}" ]; then
		_run_rc_notrunning
		return 1
	fi

	echo "Stopping ${name}."
	kill -TERM ${rc_pid:-${_cpid}}
	if ! pwait -t ${auditbeat_stop_timeout} ${_pids} 2>/dev/null; then
		echo "${name} did not exit after ${auditbeat_stop_timeout}s, sending SIGKILL."
		kill -KILL ${_pids} 2>/dev/null
		wait_for_pids ${_pids}
	fi
	rm -f ${pidfile} ${child_pidfile}
}

run_rc_command "$1"
