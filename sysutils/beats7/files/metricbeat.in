#!/bin/sh

# PROVIDE: metricbeat
# REQUIRE: DAEMON
# BEFORE: LOGIN
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable metricbeat:
#
# metricbeat_enable (bool):	Set to YES to enable metricbeat
# 				Default: NO
# metricbeat_flags (str):	Extra flags passed to metricbeat
# metricbeat_env (str):	Environment variables passed to metricbeat
#				Default: PATH includes base and local bin/sbin
# metricbeat_config (str):	metricbeat configuration directory
#				Default: ${PREFIX}/etc/beats
# metricbeat_conffile (str):	metricbeat configuration file
#				relative to ${metricbeat_conf}
#				Default: metricbeat.yml
# metricbeat_stop_timeout (int):	Seconds to wait after SIGTERM
#				before sending SIGKILL
#				Default: 15

. /etc/rc.subr

name="metricbeat"
rcvar=${name}_enable
load_rc_config $name

: ${metricbeat_enable:="NO"}
: ${metricbeat_env:="PATH=/sbin:/bin:/usr/sbin:/usr/bin:%%LOCALBASE%%/sbin:%%LOCALBASE%%/bin"}
: ${metricbeat_config:="%%ETCDIR%%"}
: ${metricbeat_conffile:="metricbeat.yml"}
: ${metricbeat_home:="%%DATADIR%%/metricbeat"}
: ${metricbeat_logs:="/var/log/beats"}
: ${metricbeat_data:="/var/db/beats/metricbeat"}
: ${metricbeat_stop_timeout:="15"}

# daemon
start_precmd=metricbeat_prestart
stop_cmd=metricbeat_stop
command=/usr/sbin/daemon
pidfile="/var/run/${name}"
child_pidfile="${pidfile}.child"
command_args="-fr -P ${pidfile} -p ${child_pidfile} %%PREFIX%%/sbin/${name} ${metricbeat_flags} --path.config ${metricbeat_config} --path.home ${metricbeat_home} --path.data ${metricbeat_data} --path.logs ${metricbeat_logs} -c ${metricbeat_conffile}"

metricbeat_prestart() {
# Have to empty rc_flags so they don't get passed to daemon(8)
	rc_flags=""
}

# daemon(8) forwards SIGTERM to the beat and stops restarting it.  A beat
# still running after metricbeat_stop_timeout seconds (seen with linprocfs
# mounted) is killed along with daemon(8), so that no orphaned beat keeps
# the data path locked.
metricbeat_stop() {
	local _cpid _pids

	_cpid=$(check_pidfile ${child_pidfile} %%PREFIX%%/sbin/${name})
	# instances started without -p have no child pidfile
	if [ -z "${_cpid}" -a -n "${rc_pid}" ]; then
		_cpid=$(pgrep -P ${rc_pid})
	fi
	_pids=$(echo ${rc_pid} ${_cpid})
	if [ -z "${_pids}" ]; then
		_run_rc_notrunning
		return 1
	fi

	echo "Stopping ${name}."
	kill -TERM ${rc_pid:-${_cpid}}
	if ! pwait -t ${metricbeat_stop_timeout} ${_pids} 2>/dev/null; then
		echo "${name} did not exit after ${metricbeat_stop_timeout}s, sending SIGKILL."
		kill -KILL ${_pids} 2>/dev/null
		wait_for_pids ${_pids}
	fi
	rm -f ${pidfile} ${child_pidfile}
}

run_rc_command "$1"
