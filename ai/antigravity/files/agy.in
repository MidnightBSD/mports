#!/bin/sh
#
# Wrapper script for the Google Antigravity CLI.
# AGY_CLI_DISABLE_AUTO_UPDATE=1 stops the binary from replacing itself in
# ${PREFIX}, which would defeat mport's tracking of the installed files.
#
AGY_CLI_DISABLE_AUTO_UPDATE=1
export AGY_CLI_DISABLE_AUTO_UPDATE
exec %%PREFIX%%/lib/linux-antigravity/antigravity "$@"
