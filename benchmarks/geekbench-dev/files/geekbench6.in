#!/bin/sh

case "$0" in
/*|*/*)
	prog=$0
	;;
*)
	prog=$(command -v "$0")
	;;
esac

if [ "$(id -u)" -eq 0 ]; then
	printf '%s\n' \
	    'Warning: Geekbench may crash as root due to /dev/mem compatibility issues.' \
	    'Run Geekbench as a non-root user instead.' >&2
fi

prefix=$(dirname "$(dirname "$prog")")
"${prefix}/libexec/geekbench6/geekbench6" "$@"
status=$?

exit "${status}"
